# Copy to lakehouse/.env and fill in. lakehouse/.env is gitignored: never commit it.

# Postgres used by the app (docker compose publishes it on localhost:5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidentia

# Where the bronze export writes: "local" (./lake), "s3", "volume", or a list like "s3,volume".
LAKE_TARGET=local
LOCAL_LAKE_DIR=./lake
LAKE_PREFIX=bronze

# S3 target. boto3 reads the AWS_* variables itself; the code never handles the keys.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Databricks volume target (Free Edition can't read your S3 bucket directly).
# Host looks like https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VOLUME_PATH=/Volumes/workspace/evidentia/landing
